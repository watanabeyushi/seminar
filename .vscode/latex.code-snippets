{
  "ゼミ用Beamerテンプレート": {
    "scope": "latex",
    "prefix": "seminar",
    "description": "日本語Beamerスライドの初期テンプレート（章フォルダの tex/ 用）",
    "body": [
      "% !TEX program = lualatex",
      "\\input{../../common/preamble}",
      "\\title{The Principles of Diffusion Models}",
      "\\subtitle{${1:節タイトル}}",
      "",
      "\\begin{document}",
      "\\begin{frame}",
      "    \\titlepage",
      "\\end{frame}",
      "\\input{../slides/${2:ファイル名}}",
      "\\end{document}"
    ]
  }
}

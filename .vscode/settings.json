{
  "files.encoding": "utf8",
  "files.associations": {
    "*.tex": "latex"
  },
  "files.exclude": {
    "**/build": true,
    "**/tex/*.pdf": true,
    "**/tex/*.aux": true,
    "**/tex/*.log": true,
    "**/tex/*.fls": true,
    "**/tex/*.fdb_latexmk": true,
    "**/tex/*.synctex.gz": true,
    "**/tex/*.nav": true,
    "**/tex/*.out": true,
    "**/tex/*.snm": true,
    "**/tex/*.toc": true
  },
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "%DIR%/../pdf",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk (LuaLaTeX)",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-auxdir=..\\build",
        "-outdir=..\\pdf",
        "%DOCFILE%"
      ],
      "env": {},
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (LuaLaTeX)",
      "tools": [
        "latexmk (LuaLaTeX)"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.view.pdf.viewer": "external",
  "latex-workshop.view.pdf.refreshenabled": true,
  "latex-workshop.view.pdf.external.viewer.command": "C:\\Users\\gnqkn\\AppData\\Local\\SumatraPDF\\SumatraPDF.exe",
  "latex-workshop.view.pdf.external.viewer.args": [
    "-reuse-instance",
    "-inverse-search",
    "C:\\Program Files\\cursor\\Cursor.exe -r -g \"%f:%l\"",
    "%PDF%"
  ],
  "latex-workshop.view.pdf.external.synctex.command": "C:\\Users\\gnqkn\\AppData\\Local\\SumatraPDF\\SumatraPDF.exe",
  "latex-workshop.view.pdf.external.synctex.args": [
    "-reuse-instance",
    "-forward-search",
    "%TEX%",
    "%LINE%",
    "-inverse-search",
    "C:\\Program Files\\cursor\\Cursor.exe -r -g \"%f:%l\"",
    "%PDF%"
  ]
}
